                "reference": "3b076923d2f152f19df5d702ab24b3e9095aec55",
                "shasum": ""
            },
            "require": {
                "ext-mbstring": "*",
                "php": "^8.2"
            },
            "require-dev": {
                "friendsofphp/php-cs-fixer": "^3.64",
                "phpstan/phpstan": "^2.1",
                "phpunit/phpunit": "^12.0"
            },
            "time": "2026-07-29T23:52:11+00:00",
            "default-branch": true,
            "type": "library",
            "installation-source": "dist",
            "autoload": {
                "psr-4": {
                    "Iliaal\\NameParser\\": "src/"
                }
            },
            "autoload-dev": {
                "psr-4": {
                    "Tests\\Iliaal\\NameParser\\": "tests/"
                }
            },
            "scripts": {
                "analyse": [
                    "phpstan analyse"
                ],
                "check:readme": [
                    "php -r \"exit(substr_count(file_get_contents('README.md'), \\\"—\\\") === 0 ? 0 : 1);\""
                ],
                "lint": [
                    "php-cs-fixer fix --dry-run --diff"
                ],
                "lint:fix": [
                    "php-cs-fixer fix"
                ],
                "test": [
                    "phpunit"
                ]
            },
            "license": [
                "MIT"
            ],
            "authors": [
                {
                    "name": "Ilia Alshanetsky",
                    "email": "ilia@ilia.ws"
                }
            ],
            "description": "Parse a full-name string into its parts. Casing- and credential-aware fork of theiconic/name-parser, tuned for professional/clinician names.",
            "keywords": [
                "credentials",
                "fullname",
                "humanname",
                "name",
                "name-parser",
                "parser"
            ],
            "support": {
                "source": "https://github.com/eileenmcnaughton/nameparser/tree/master"
